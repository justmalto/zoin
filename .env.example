SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_RESUME_BUCKET=resumes

# Groq Free-plan account only. Never use VITE_ for this key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_UTILITY_MODEL=openai/gpt-oss-20b
GROQ_RESUME_MODEL=openai/gpt-oss-20b
GROQ_TOKENS_PER_MINUTE=7500
GROQ_TOKENS_PER_DAY=160000
GROQ_OWNER_TOKENS_PER_DAY=80000
GROQ_BACKGROUND_TOKENS_PER_DAY=96000
GROQ_REQUESTS_PER_MINUTE=25
GROQ_REQUESTS_PER_DAY=900
# Rolling 24-hour budgets, per model. Uses the persistent discovery directory by default.
# AI_BUDGET_DB_PATH=/data/ai-budget.sqlite3

# Server-only: generate independent random values; never prefix these with VITE_.
MAIL_ENCRYPTION_KEY=
MAIL_WORKER_KEY=
MAIL_SCHEDULER_ENABLED=true

# Railway container supplies PORT automatically. Exact Vercel origins; JSON array, no wildcard.
ALLOWED_ORIGINS=["https://zoin-three.vercel.app"]
